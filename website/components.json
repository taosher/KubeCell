{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@s": "https://raw.githubusercontent.com/shadcn-ui/ui/main/apps/v4/public/r/styles/new-york/{name}.json",
    "@magicui": "https://raw.githubusercontent.com/magicuidesign/magicui/main/apps/www/public/r/{name}.json"
  }
}
